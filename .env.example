# Flask environment (development | production)
FLASK_ENV=development

# Secret key — replace with a long, random string in production
SECRET_KEY=poultryconnect-production-secret-key-2026

# MySQL Connection for XAMPP (Default: user=root, no password, host=127.0.0.1, port=3306)
# Import poultryconnect_xampp.sql into phpMyAdmin first!
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/poultryconnect?charset=utf8mb4

# If you have a MySQL root password set in XAMPP:
# DATABASE_URL=mysql+pymysql://root:yourpassword@127.0.0.1:3306/poultryconnect?charset=utf8mb4

# Optional: Run with SQLite instead of MySQL
# DATABASE_URL=sqlite:///poultryconnect.db
# DB_CONNECTION=sqlite
